// =============================================================================
// ZUKI COMMERCE OS — schema.prisma
// Argentina Edition · ARS · America/Argentina/Buenos_Aires · AR
// =============================================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearchPostgres"]
}

datasource db {
  provider = "postgresql"
}

// =============================================================================
// ENUMS
// =============================================================================

enum Plan {
  FREE
  STARTER
  PRO
  ENTERPRISE

  @@map("plan")
}

enum MemberRole {
  OWNER    // dueño del comercio, acceso total
  MANAGER  // gerente, puede gestionar todo menos billing
  STAFF    // empleado, acceso operativo
  CASHIER  // solo POS y pedidos

  @@map("member_role")
}

enum CondicionFiscal {
  RESPONSABLE_INSCRIPTO
  MONOTRIBUTISTA
  CONSUMIDOR_FINAL
  EXENTO
  NO_RESPONSABLE

  @@map("condicion_fiscal")
}

enum LocationType {
  STORE      // local de venta
  WAREHOUSE  // depósito / bodega
  VIRTUAL    // stock virtual (dropshipping, consignación)

  @@map("location_type")
}

enum ProductStatus {
  DRAFT    // borrador, no visible
  ACTIVE   // publicado
  ARCHIVED // descontinuado

  @@map("product_status")
}

enum MovementType {
  INITIAL_STOCK   // carga inicial
  PURCHASE        // compra a proveedor
  SALE            // venta
  RETURN_IN       // devolución del cliente
  RETURN_OUT      // devolución a proveedor
  ADJUSTMENT_IN   // ajuste positivo (inventario físico)
  ADJUSTMENT_OUT  // ajuste negativo (merma, robo)
  TRANSFER_IN     // entrada por transferencia entre sucursales
  TRANSFER_OUT    // salida por transferencia entre sucursales
  DAMAGE          // daño / pérdida

  @@map("movement_type")
}

enum OrderChannel {
  WEB        // tienda online
  WHATSAPP   // pedido por WhatsApp
  POS        // punto de venta presencial
  MANUAL     // creado manualmente desde el admin
  PHONE      // pedido telefónico

  @@map("order_channel")
}

enum OrderStatus {
  PENDING     // recibido, sin confirmar
  CONFIRMED   // confirmado por el comercio
  PROCESSING  // en preparación / armado
  READY       // listo para entrega o retiro
  SHIPPED     // enviado (para delivery)
  DELIVERED   // entregado al cliente
  CANCELLED   // cancelado
  REFUNDED    // reembolsado

  @@map("order_status")
}

enum PaymentStatus {
  UNPAID    // sin pagos registrados
  PARTIAL   // pago parcial
  PAID      // pagado en su totalidad
  REFUNDED  // reembolsado
  VOID      // anulado

  @@map("payment_status")
}

enum PaymentMethod {
  CASH            // efectivo
  DEBIT_CARD      // tarjeta de débito
  CREDIT_CARD     // tarjeta de crédito
  TRANSFER        // transferencia bancaria / CBU
  MERCADOPAGO     // MercadoPago (app, QR, link)
  RAPIPAGO        // Rapipago
  PAGOFACIL       // Pago Fácil
  QR              // QR genérico (MODO, Naranja X, etc.)
  CRYPTO          // criptomonedas
  OTHER           // otro medio

  @@map("payment_method")
}

enum WhatsAppMessageType {
  TEXT
  IMAGE
  AUDIO
  VIDEO
  DOCUMENT
  LOCATION
  TEMPLATE   // mensaje de plantilla HSM
  INTERACTIVE // botones o listas
  STICKER
  REACTION

  @@map("whatsapp_message_type")
}

enum WhatsAppMessageStatus {
  SENT
  DELIVERED
  READ
  FAILED

  @@map("whatsapp_message_status")
}

enum ConversationStatus {
  OPEN        // nueva, sin atender
  IN_PROGRESS // siendo atendida
  RESOLVED    // resuelta
  ARCHIVED    // archivada

  @@map("conversation_status")
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  RESTORE
  LOGIN
  LOGOUT
  EXPORT

  @@map("audit_action")
}

enum InsightType {
  SALES_FORECAST      // proyección de ventas
  LOW_STOCK_ALERT     // predicción de quiebre de stock
  TOP_PRODUCTS        // productos más vendidos
  CUSTOMER_CHURN      // clientes en riesgo de abandono
  BEST_CHANNEL        // canal de venta más rentable
  PEAK_HOURS          // horarios pico de pedidos
  MARGIN_ANALYSIS     // análisis de márgenes
  REORDER_SUGGESTION  // sugerencia de reposición

  @@map("insight_type")
}

enum InsightStatus {
  PENDING   // en cola para generar
  READY     // disponible
  EXPIRED   // caducado
  FAILED    // error al generar

  @@map("insight_status")
}

// =============================================================================
// AUTH — NextAuth v5
// =============================================================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  avatarUrl     String?
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts    Account[]
  sessions    Session[]
  memberships Member[]
  auditLogs   AuditLog[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// =============================================================================
// TENANCY — Organización, Membresía, Invitaciones
// =============================================================================

model Organization {
  id       String @id @default(cuid())
  slug     String @unique // zuki.app/[slug]
  name     String
  // razón social para facturación
  legalName String?
  // CUIT sin guiones: 20123456789
  cuit      String?
  logoUrl   String?

  // configuración regional Argentina
  currency String          @default("ARS")
  timezone String          @default("America/Argentina/Buenos_Aires")
  country  String          @default("AR")

  condicionFiscal CondicionFiscal @default(MONOTRIBUTISTA)
  plan            Plan            @default(FREE)

  // contador autoincremental de pedidos por org (para número de orden)
  nextOrderNumber Int @default(1001)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // soft delete

  members     Member[]
  invitations Invitation[]
  categories  Category[]
  products    Product[]
  locations   Location[]
  customers   Customer[]
  orders      Order[]
  settings    OrgSettings?
  auditLogs   AuditLog[]
  domainEvents DomainEvent[]
  insights    AIInsight[]
  conversations WhatsAppConversation[]

  @@index([slug])
  @@index([deletedAt])
  @@map("organizations")
}

model Member {
  id             String     @id @default(cuid())
  organizationId String
  userId         String
  role           MemberRole @default(STAFF)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("members")
}

model Invitation {
  id             String     @id @default(cuid())
  organizationId String
  email          String
  role           MemberRole @default(STAFF)
  token          String     @unique @default(cuid())
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime   @default(now())
  invitedById    String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, email])
  @@index([token])
  @@map("invitations")
}

// =============================================================================
// CATÁLOGO — Categorías, Productos, Variantes
// =============================================================================

model Category {
  id             String   @id @default(cuid())
  organizationId String
  parentId       String?
  name           String
  slug           String
  description    String?
  imageUrl       String?
  sortOrder      Int      @default(0)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parent       Category?    @relation("CategoryTree", fields: [parentId], references: [id])
  children     Category[]   @relation("CategoryTree")
  products     Product[]

  @@unique([organizationId, slug])
  @@index([organizationId, isActive])
  @@map("categories")
}

model Product {
  id             String        @id @default(cuid())
  organizationId String
  categoryId     String?
  name           String
  slug           String
  description    String?       @db.Text
  imageUrls      String[]
  tags           String[]
  status         ProductStatus @default(DRAFT)

  // control de stock
  trackStock     Boolean @default(true)
  allowBackorder Boolean @default(false)

  // campo libre para atributos extra (fichas técnicas, etc.)
  metadata Json @default("{}")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category     Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  variants     ProductVariant[]

  @@unique([organizationId, slug])
  @@index([organizationId, status])
  @@index([organizationId, deletedAt])
  @@map("products")
}

model ProductVariant {
  id        String @id @default(cuid())
  productId String
  sku       String
  name      String // "Talle M / Rojo", "1L", "Negro 42"
  barcode   String? // código de barras EAN-13 o QR

  // precios en ARS
  price        Decimal  @db.Decimal(12, 2)
  compareAt    Decimal? @db.Decimal(12, 2) // precio tachado
  costPrice    Decimal? @db.Decimal(12, 2) // precio de costo (margen)

  // atributos del variante: {"talle": "M", "color": "Rojo"}
  attributes Json @default("{}")

  weight     Float?
  weightUnit String @default("kg")

  isDefault Boolean  @default(false)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product    Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventory  InventoryLevel[]
  orderItems OrderItem[]
  movements  InventoryMovement[]

  @@unique([productId, sku])
  @@index([barcode])
  @@index([productId, isActive])
  @@map("product_variants")
}

// =============================================================================
// INVENTARIO — Ubicaciones, Niveles, Movimientos
// =============================================================================

model Location {
  id             String       @id @default(cuid())
  organizationId String
  name           String       // "Local Centro", "Depósito Quilmes"
  type           LocationType @default(STORE)
  address        String?
  isActive       Boolean      @default(true)
  isDefault      Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inventory    InventoryLevel[]
  movements    InventoryMovement[]

  @@index([organizationId, isActive])
  @@map("locations")
}

model InventoryLevel {
  id         String   @id @default(cuid())
  variantId  String
  locationId String
  quantity   Int      @default(0) // stock disponible
  reserved   Int      @default(0) // reservado en pedidos pendientes
  incoming   Int      @default(0) // en tránsito / pedidos a proveedor
  updatedAt  DateTime @updatedAt

  variant  ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  location Location       @relation(fields: [locationId], references: [id], onDelete: Cascade)

  // available = quantity - reserved (calculado en queries)
  @@unique([variantId, locationId])
  @@map("inventory_levels")
}

model InventoryMovement {
  id             String       @id @default(cuid())
  organizationId String
  variantId      String
  locationId     String
  type           MovementType

  // positivo = entrada, negativo = salida
  quantity       Int
  quantityBefore Int   // snapshot para auditoría
  quantityAfter  Int   // snapshot para auditoría

  reason      String? // nota libre
  // referencia al origen del movimiento (orderId, purchaseId, etc.)
  reference   String?
  referenceType String? // "order", "purchase", "adjustment"

  createdAt   DateTime @default(now())
  createdById String?  // userId que realizó el movimiento

  variant  ProductVariant @relation(fields: [variantId], references: [id])
  location Location       @relation(fields: [locationId], references: [id])

  @@index([organizationId, variantId])
  @@index([organizationId, createdAt])
  @@index([reference])
  @@map("inventory_movements")
}

// =============================================================================
// CRM — Clientes y Direcciones
// =============================================================================

model Customer {
  id             String    @id @default(cuid())
  organizationId String

  name  String
  email String?
  // formato E.164 con código Argentina: +5491112345678
  // el "9" es necesario para WhatsApp en AR
  phone String?

  // identificación argentina
  dni    String? // documento nacional de identidad
  cuit   String? // CUIT/CUIL para facturas

  condicionFiscal CondicionFiscal @default(CONSUMIDOR_FINAL)

  // WhatsApp
  whatsappId String? // phone ID en WhatsApp Business API

  notes String?
  tags  String[]

  // métricas denormalizadas (actualizadas por triggers/acciones)
  totalOrders Int     @default(0)
  totalSpent  Decimal @default(0) @db.Decimal(12, 2)
  lastOrderAt DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  organization  Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  addresses     CustomerAddress[]
  orders        Order[]
  conversations WhatsAppConversation[]

  @@unique([organizationId, phone])
  @@index([organizationId, deletedAt])
  @@index([organizationId, lastOrderAt])
  @@map("customers")
}

model CustomerAddress {
  id         String @id @default(cuid())
  customerId String
  label      String @default("Casa") // "Casa", "Trabajo", "Otro"

  // campos para Argentina
  street      String          // calle y número: "Av. Corrientes 1234"
  floor       String?         // piso
  apartment   String?         // departamento / unidad
  localidad   String          // ciudad / localidad
  provincia   ArgentinaProv   // enum de provincias
  codigoPostal String?        // CP
  country     String          @default("AR")

  notes     String?
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("customer_addresses")
}

// provincias argentinas — evita typos y facilita filtros/reportes
enum ArgentinaProv {
  BUENOS_AIRES
  CABA
  CATAMARCA
  CHACO
  CHUBUT
  CORDOBA
  CORRIENTES
  ENTRE_RIOS
  FORMOSA
  JUJUY
  LA_PAMPA
  LA_RIOJA
  MENDOZA
  MISIONES
  NEUQUEN
  RIO_NEGRO
  SALTA
  SAN_JUAN
  SAN_LUIS
  SANTA_CRUZ
  SANTA_FE
  SANTIAGO_DEL_ESTERO
  TIERRA_DEL_FUEGO
  TUCUMAN

  @@map("argentina_prov")
}

// =============================================================================
// COMERCIO — Pedidos, Items, Pagos, Timeline
// =============================================================================

model Order {
  id             String        @id @default(cuid())
  organizationId String
  customerId     String?

  // número legible por humanos: #1001, #1002 — único por org
  number  Int
  channel OrderChannel
  status  OrderStatus   @default(PENDING)
  paymentStatus PaymentStatus @default(UNPAID)

  // totales en ARS
  subtotal Decimal @db.Decimal(12, 2)
  discount Decimal @default(0) @db.Decimal(12, 2)
  // IVA: 21% default (puede ser 10.5% o 27% por tipo de producto)
  taxRate  Decimal @default(21) @db.Decimal(5, 2)
  tax      Decimal @default(0) @db.Decimal(12, 2)
  total    Decimal @db.Decimal(12, 2)

  // dirección de envío (snapshot al momento del pedido)
  shippingAddress Json?

  notes         String? // nota del cliente
  internalNotes String? // nota interna del comercio

  // asignado a un miembro del staff
  assignedToId String?

  // datos extra según canal (ej: whatsapp conversation id, etc.)
  metadata Json @default("{}")

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  confirmedAt  DateTime?
  completedAt  DateTime?
  cancelledAt  DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items        OrderItem[]
  payments     Payment[]
  events       OrderEvent[]

  @@unique([organizationId, number])
  @@index([organizationId, status])
  @@index([organizationId, paymentStatus])
  @@index([organizationId, channel])
  @@index([organizationId, createdAt])
  @@index([customerId])
  @@map("orders")
}

model OrderItem {
  id        String @id @default(cuid())
  orderId   String
  variantId String

  quantity  Int
  unitPrice Decimal @db.Decimal(12, 2)
  discount  Decimal @default(0) @db.Decimal(12, 2)
  taxRate   Decimal @default(21) @db.Decimal(5, 2)
  subtotal  Decimal @db.Decimal(12, 2)
  tax       Decimal @default(0) @db.Decimal(12, 2)
  total     Decimal @db.Decimal(12, 2)

  // snapshot inmutable del producto al momento de la venta
  snapshot Json // { name, sku, imageUrl, variantName, barcode }

  notes String?

  order   Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@index([orderId])
  @@index([variantId])
  @@map("order_items")
}

model Payment {
  id             String        @id @default(cuid())
  orderId        String
  organizationId String

  method      PaymentMethod
  amount      Decimal       @db.Decimal(12, 2)
  currency    String        @default("ARS")

  // cuotas — muy común en Argentina con tarjetas
  installments Int     @default(1)
  installmentAmount Decimal? @db.Decimal(12, 2)

  // referencia externa (MP payment ID, CBU origen, etc.)
  reference String?
  gateway   String? // "mercadopago", "stripe", "manual"

  status String @default("completed") // completed, pending, failed, refunded

  paidAt    DateTime @default(now())
  createdAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([organizationId, paidAt])
  @@map("payments")
}

model OrderEvent {
  id      String @id @default(cuid())
  orderId String

  // tipo del evento: "status_changed", "payment_added", "note_added", etc.
  type    String
  payload Json   // datos del evento (before/after status, amount, etc.)

  // quién lo generó (puede ser sistema o usuario)
  createdById   String?
  createdByName String? // snapshot del nombre para no depender de FK
  createdAt     DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@map("order_events")
}

// =============================================================================
// WHATSAPP — Conversaciones y Mensajes
// =============================================================================

model WhatsAppConversation {
  id             String             @id @default(cuid())
  organizationId String
  customerId     String?

  // número de teléfono del contacto (E.164)
  phoneNumber  String
  contactName  String?  // nombre como aparece en WhatsApp

  status       ConversationStatus @default(OPEN)
  unreadCount  Int                @default(0)

  // si la conversación derivó en un pedido
  orderId String?

  // staff asignado a esta conversación
  assignedToId String?

  lastMessageAt DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer?            @relation(fields: [customerId], references: [id], onDelete: SetNull)
  messages     WhatsAppMessage[]

  @@index([organizationId, status])
  @@index([organizationId, lastMessageAt])
  @@index([phoneNumber])
  @@map("whatsapp_conversations")
}

model WhatsAppMessage {
  id             String                  @id @default(cuid())
  conversationId String

  direction String                     // "inbound" | "outbound"
  type      WhatsAppMessageType        @default(TEXT)
  status    WhatsAppMessageStatus?     // solo aplica a outbound

  body         String?   @db.Text
  mediaUrl     String?
  mediaType    String?   // "image/jpeg", "audio/ogg", etc.
  mediaCaption String?

  // ID externo del mensaje en WhatsApp Business API / Evolution API
  externalId String?

  // reacción, reply-to, etc.
  metadata Json @default("{}")

  createdAt DateTime @default(now())

  conversation WhatsAppConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([externalId])
  @@map("whatsapp_messages")
}

// =============================================================================
// CONFIGURACIÓN — Ajustes por Organización
// =============================================================================

model OrgSettings {
  organizationId String @id

  // tienda
  storeName        String?
  storeDescription String? @db.Text
  storeUrl         String? // dominio personalizado futuro
  enablePublicStore Boolean @default(false)

  // WhatsApp Business
  whatsappNumber     String? // número con código Argentina: +5491112345678
  whatsappApiUrl     String? // URL de Evolution API self-hosted
  whatsappApiToken   String? // API key (almacenar encriptado en prod)
  whatsappBusinessId String?
  enableWhatsApp     Boolean @default(false)

  // mensajes automáticos de WhatsApp
  greetingMessage  String? @db.Text
  awayMessage      String? @db.Text
  orderConfirmationTemplate String?

  // fiscal Argentina
  defaultTaxRate     Decimal @default(21) @db.Decimal(5, 2) // IVA 21%
  enableInvoicing    Boolean @default(false) // factura electrónica AFIP
  invoicePrefix      String  @default("FC")
  invoiceLastNumber  Int     @default(0)

  // inventario
  lowStockThreshold  Int     @default(5)
  enableLowStockAlert Boolean @default(true)
  defaultLocationId  String?

  // POS
  enablePos          Boolean @default(false)
  posRequirePin      Boolean @default(false)

  // notificaciones
  notifyEmail        String? // email para notificaciones del sistema
  notifyNewOrder     Boolean @default(true)
  notifyLowStock     Boolean @default(true)

  // tema / personalización
  primaryColor  String? // hex color
  accentColor   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("org_settings")
}

// =============================================================================
// SISTEMA — Auditoría, Domain Events, IA
// =============================================================================

model AuditLog {
  id             String      @id @default(cuid())
  organizationId String
  userId         String?

  // snapshot del usuario al momento de la acción
  userEmail String?
  userName  String?

  action     AuditAction
  // nombre del modelo afectado: "Order", "Product", "Customer", etc.
  entity     String
  entityId   String

  // diff del cambio
  before Json? // estado previo
  after  Json? // estado nuevo

  // contexto de red
  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, entity, entityId])
  @@index([organizationId, createdAt])
  @@index([userId])
  @@map("audit_logs")
}

model DomainEvent {
  id             String   @id @default(cuid())
  organizationId String

  // ej: "order.confirmed", "inventory.low_stock", "customer.created"
  type          String
  // tipo del aggregate raíz: "Order", "Product", "Customer"
  aggregateType String
  aggregateId   String

  payload  Json // datos del evento
  metadata Json @default("{}") // causationId, correlationId, version

  // para sistemas de procesamiento de eventos
  processed   Boolean   @default(false)
  processedAt DateTime?
  failedAt    DateTime?
  failReason  String?
  retries     Int       @default(0)

  createdAt DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, type])
  @@index([organizationId, aggregateType, aggregateId])
  @@index([processed, createdAt]) // para el worker de procesamiento
  @@map("domain_events")
}

model AIInsight {
  id             String        @id @default(cuid())
  organizationId String

  type   InsightType
  status InsightStatus @default(PENDING)

  title       String
  description String  @db.Text
  // estructura del insight según el tipo
  data        Json

  // confianza del modelo 0.0 – 1.0
  confidence Float?

  // período que cubre el insight
  periodStart DateTime?
  periodEnd   DateTime?

  // para expiración automática
  generatedAt DateTime?
  expiresAt   DateTime?

  // prompt enviado y modelo usado (para debugging y mejora)
  promptUsed  String? @db.Text
  modelUsed   String?
  tokensUsed  Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, type, status])
  @@index([organizationId, expiresAt])
  @@map("ai_insights")
}
